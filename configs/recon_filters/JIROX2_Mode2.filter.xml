<?xml version="1.0" encoding="UTF-8"?>
<FDK_filter_config>
    <FieldsLoading/>
    <GeometryLoading>
        <loadingBinary>1</loadingBinary>
    </GeometryLoading>
    <DeadPixelFix/>
    <NegtiveLog/>
    <Pwls>
        <iterCount>20</iterCount>
        <delta>0.5</delta>
        <beta>800.0</beta>
    </Pwls>
    <ImStraight/>
    <Preview/>
    <ImDump>
        <isEnable>0</isEnable>
        <outDirPath>D:\sino3</outDirPath>
        <!-- <target>preview</target>
        <target>brightField</target>
        <target>image</target> -->
    </ImDump>
    <ConeAngleCompletion>
		<isEnable>1</isEnable>
		<extNumTop>100</extNumTop>
		<extNumBot>100</extNumBot>
	</ConeAngleCompletion>
    <SinoBufferWriter/>
    <MotionDetect/>
    <AngularRWeight>
        <RedundancyCount>30</RedundancyCount>
    </AngularRWeight>
    <WCE>
        <isEnable>1</isEnable>
        <uNumExtL>200</uNumExtL>
        <uNumExtR>0</uNumExtR>
    </WCE>
    <WeightR/>
    <Ramp>
        <isEnable>1</isEnable>
        <isHamEnable>1</isHamEnable>
        <paraHam1>0.54</paraHam1>
        <paraHam2>0.46</paraHam2>
        <inputSize>4096</inputSize>
        <outputSize>2048</outputSize>
    </Ramp>
    <BP/>
    <!--Post Processes-->
    <SecondaryBP::Fix>
		<alwaysEnable>0</alwaysEnable>
		<filters>SinoBufferReader RotationAxisFix ResetVolume AngularRWeight WCE WeightR Ramp BP</filters>
        <time>25</time>
	</SecondaryBP::Fix>
    <Pose>
        <alwaysEnable>1</alwaysEnable>
    </Pose>
    <MetalBackup>
        <alwaysEnable>1</alwaysEnable>
        <metalThres>1.0</metalThres>
    </MetalBackup>
    <SecondaryBP::BHC>
        <BHC>
			<boneThresLow>0.26</boneThresLow>
			<boneThresHigh>0.3</boneThresHigh>
			<metalThresLow>0.9</metalThresLow>
			<metalThresHigh>1.0</metalThresHigh>
			<pwb>0.10</pwb>
			<pbb>0.11</pbb>
			<pwmm>0.10</pwmm>
			<pbm>0.45</pbm>
			<pb>-0.45</pb>
			<pm>-0.45</pm>
		</BHC>
        <filters>SinoBufferReader BHC AngularRWeight WCE WeightR Ramp BP</filters>
        <time>12</time>
    </SecondaryBP::BHC>
    <MARFI>
		<metalThres>1.0</metalThres>
		<metalNumThres>250</metalNumThres>
		<maxMetalNumThres>100000</maxMetalNumThres>
		<gaussMetalSigma>1.5</gaussMetalSigma>
		<gaussMetalLen>5</gaussMetalLen>
		<gradientWeightPara>0.9</gradientWeightPara>
		<cgError>0.00003</cgError>
		<cgMaxIterCount>2000</cgMaxIterCount>
		<step>1</step>
		<time>50</time>
	</MARFI>
    <SecondaryBP::RWeight>
        <RWeight>
            <uNumExt>200</uNumExt>
            <medFilterEnable>1</medFilterEnable>
            <overLapNum>10</overLapNum>
            <medianLen>20</medianLen>
        </RWeight>
        <filters>SinoBufferReader RWeight AngularRWeight WCE WeightR Ramp BP</filters>
    </SecondaryBP::RWeight>
    <SinoBufferCleaner>
		<alwaysEnable>1</alwaysEnable>
	</SinoBufferCleaner>
    <ReduceNoise>
        <ratio>1.0</ratio>
        <gradientThresh>0.01</gradientThresh>
        <time>6</time>
        <medFilterLen>5</medFilterLen>
    </ReduceNoise>
    <Anisotropic>
        <stepNum>1</stepNum>
        <filterLen>5</filterLen>
        <sigma>3.0</sigma>
        <weightZ>0.0015</weightZ>
        <time>1</time>
    </Anisotropic>
    <RCoor>
        <isNorEnable>1</isNorEnable>
        <isRingEnable>0</isRingEnable>
        <time>5</time>
    </RCoor>
    <MetalRestore>
        <alwaysEnable>1</alwaysEnable>
    </MetalRestore>
    <WaterCali>
        <alwaysEnable>1</alwaysEnable>
    </WaterCali>
    <CalcCephAngle>
        <alwaysEnable>1</alwaysEnable>
    </CalcCephAngle>
    <DigitalLateral>
        <size>1920</size>
        <isUseCustom>1</isUseCustom>
        <stepNum>640</stepNum>
        <sharpenSigma>5</sharpenSigma>
        <sharpenRatio>1.5</sharpenRatio>
        <alpha>1.0</alpha>
		<beta>0.0</beta>
    </DigitalLateral>
    <DigitalAnterioposterior/>
    <DigitalPano>
        <alpha>0.6</alpha>
        <beta>-0.06</beta>
    </DigitalPano>
</FDK_filter_config>