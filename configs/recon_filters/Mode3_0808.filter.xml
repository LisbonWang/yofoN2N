<?xml version="1.0" encoding="UTF-8"?>
<FDK_filter_config>
	<FieldsLoading/>
	<GeometryLoading>
		<loadingBinary>1</loadingBinary>
	</GeometryLoading>
	<DeadPixelFix/>
	<NegtiveLog/>
	<Pwls>
		<isEnable>0</isEnable>
		<iterCount>20</iterCount>
		<delta>0.5</delta>
		<beta>600.0</beta>
	</Pwls>
	<ImStraight/>
	<Preview/>
	<ImDump>
		<isEnable>0</isEnable>
		<outDirPath>D:\sino3</outDirPath>
		<!-- <target>preview</target>
		<target>brightField</target>
		<target>image</target> -->
	</ImDump>
	<ConeAngleCompletion>
		<isEnable>1</isEnable>
		<extNumTop>100</extNumTop>
		<extNumBot>100</extNumBot>
	</ConeAngleCompletion>
	<SinoBufferWriter>
		<compressed>1</compressed>
	</SinoBufferWriter>
	<WCE>
		<isEnable>1</isEnable>
		<uNumExtL>200</uNumExtL>
		<uNumExtR>0</uNumExtR>
	</WCE>
	<Comp180/>
	<WeightR/>
	<Ramp>
		<isEnable>1</isEnable>
	    <isHamEnable>0</isHamEnable>
		<paraHam1>0.54</paraHam1>
		<paraHam2>0.46</paraHam2>
		<inputSize>4096</inputSize>
		<outputSize>2048</outputSize>
	</Ramp>
	<BP/>
	<!--Post Processes-->
	<MetalBackup>
		<alwaysEnable>1</alwaysEnable>
		<metalThres>1.0</metalThres>
	</MetalBackup>
	<SecondaryBP::BHC>
		<BHC>
			<boneThresLow>0.3</boneThresLow>
			<boneThresHigh>0.4</boneThresHigh>
			<metalThresLow>0.9</metalThresLow>
			<metalThresHigh>1.0</metalThresHigh>
			<pwb>0.03</pwb>
			<pbb>0.11</pbb>
			<pwmm>0.10</pwmm>
			<pbm>0.45</pbm>
			<pb>-0.2</pb>
			<pm>-0.45</pm>
		</BHC>
		<filters>SinoBufferReader BHC WCE Comp180 WeightR Ramp BP</filters>
		<time>12</time>
	</SecondaryBP::BHC>
	<MARFI>
		<metalThres>1.0</metalThres>
		<metalNumThres>250</metalNumThres>
		<maxMetalNumThres>100000</maxMetalNumThres>
		<gaussMetalSigma>1</gaussMetalSigma>
		<gaussMetalLen>3</gaussMetalLen>
		<gradientWeightPara>0.7</gradientWeightPara>
		<cgError>0.00003</cgError>
		<cgMaxIterCount>2000</cgMaxIterCount>
		<step>2</step>
		<time>50</time>
	</MARFI>
	<SinoBufferCleaner>
		<alwaysEnable>1</alwaysEnable>
	</SinoBufferCleaner>
	<ReduceNoise>
		<ratio>1.0</ratio>
		<gradientThresh>0.01</gradientThresh>
		<time>6</time>
		<medFilterLen>7</medFilterLen>
	</ReduceNoise>
	<Anisotropic>
		<stepNum>1</stepNum>
		<filterLen>7</filterLen>
		<sigma>3.0</sigma>
		<weightZ>0.0015</weightZ>
		<time>1</time>
	</Anisotropic>
	<RCoor>
		<isNorEnable>1</isNorEnable>
		<isRingEnable>0</isRingEnable>
		<time>5</time>
	</RCoor>
	<MetalRestoreEx>
		<alwaysEnable>1</alwaysEnable>
	</MetalRestoreEx>
	<WaterCali>
		<alwaysEnable>1</alwaysEnable>
	</WaterCali>
</FDK_filter_config>